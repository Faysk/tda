{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"includes": [
			"src/**",
			"tests/**",
			"tools/**",
			".github/**",
			"*.ts",
			"*.tsx",
			"*.js",
			"*.mjs",
			"*.cjs",
			"!next-env.d.ts"
		]
	},
	"formatter": {
		"enabled": true
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
