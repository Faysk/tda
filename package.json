{
  "name": "tda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint . --max-diagnostics=1000",
    "test": "vitest run && node --test tools/media/recovery.test.mjs tools/media/publication-contract.test.mjs tools/media/lore-assets.test.mjs tools/media/d-favicon.test.mjs tools/media/pipeline.test.mjs tools/media/verify-public.test.mjs tools/world-entity-media-r2-policy.test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm diary:check && pnpm media:validate && pnpm design:check && pnpm ux:inventory && pnpm ux:feedback && pnpm docs:check && pnpm db:docs:check",
    "diary:generate": "node tools/diary/generate.mjs",
    "diary:check": "node tools/diary/generate.mjs --check",
    "media:validate": "node tools/media/pipeline.mjs validate",
    "media:publish": "node tools/media/pipeline.mjs publish",
    "media:verify-public": "node tools/media/verify-public.mjs",
    "smoke:world-media:production": "node tools/world-entity-media-production-smoke.mjs",
    "smoke:transcript-handoff:production": "node tools/transcript-handoff-production-smoke.mjs",
    "design:check": "node tools/check-design-system.mjs",
    "docs:check": "node tools/check-docs.mjs",
    "docs:generate": "node tools/documentation-catalog.mjs --write",
    "db:docs:check": "node tools/check-database-governance.mjs",
    "ux:inventory": "node tools/ux/layout-surface-inventory.mjs",
    "ux:feedback": "node tools/ux/async-feedback-contract.mjs",
    "test:e2e": "playwright test && playwright test --config playwright.statistics.config.ts && playwright test --config playwright.permissions.config.ts",
    "test:processing": "playwright test --config playwright.processing.config.ts",
    "test:processing:ux": "playwright test --config playwright.processing-ux.config.ts",
    "test:processing:integration": "playwright test --config playwright.processing-integration.config.ts",
    "verify:connections": "node --env-file=.env.local tools/verify-connections.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1144.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
